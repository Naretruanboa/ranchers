# Rancher Environment Configuration Example
# Copy this file to .env and update with your values
# DO NOT commit .env file with real passwords to git

# Bootstrap password for initial admin account
# Generate secure password: openssl rand -base64 32
CATTLE_BOOTSTRAP_PASSWORD=admin@123

# Server hostname for SSL certificate generation
# Use FQDN for production deployments
SERVER_HOSTNAME=localhost

# Optional: Custom registry configuration
# CATTLE_SYSTEM_DEFAULT_REGISTRY_ENDPOINT=registry.example.com

# Optional: Enable audit logging for compliance
# CATTLE_API_AUDIT_LOG_ENABLED=true

# Optional: Rancher environment labels
# CATTLE_ENV_LABELS=env:production,team:platform
